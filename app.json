{
  "name": "NequiExpenseTracker",
  "displayName": "Nequi Expense Tracker",
  "version": "1.0.0",
  "expo": {
    "sdkVersion": "48.0.0",
    "platforms": ["ios", "android"],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.nequiexpensetracker",
      "permissions": ["SMS", "INTERNET"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}